---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="easyhaloo · 技术阅读与长期笔记" description="easyhaloo 是一个聚焦技术阅读、工程译文与长期知识沉淀的个人站点。">
  <section class="landing">
    <div class="intro">
      <p class="eyebrow"><span></span> EASYHALOO / NOTES FOR BUILDERS</p>
      <h1>让技术阅读，<br /><em>留下痕迹。</em></h1>
      <p class="lede">easyhaloo 是一个聚焦工程阅读与长期笔记的个人站点。这里整理值得深入理解的工程文章中文版本，也保留过去的技术学习记录。</p>
    </div>

    <div class="motion-field" aria-hidden="true">
      <div class="halo halo-one"></div>
      <div class="halo halo-two"></div>
      <div class="orbit orbit-a"><i></i></div>
      <div class="orbit orbit-b"><i></i></div>
      <div class="icon-core"><img src="/easyhaloo-icon.png" alt="" /></div>
      <span class="label label-one">阅读</span>
      <span class="label label-two">沉淀</span>
    </div>
  </section>

  <nav class="route-nav" aria-label="站点路由导航">
    <a href="/engineering-cn/">
      <span class="route-index">01</span>
      <div><strong>工程译文</strong><small>保留图文、代码与原文链接的中文阅读版本。</small></div>
      <b>→</b>
    </a>
    <a href="/legacy/">
      <span class="route-index">02</span>
      <div><strong>历史归档</strong><small>Java、JavaScript、Cloud 与工程实践笔记。</small></div>
      <b>→</b>
    </a>
    <a href="/about/">
      <span class="route-index">03</span>
      <div><strong>关于站点</strong><small>了解内容方向与发布原则。</small></div>
      <b>→</b>
    </a>
  </nav>

  <p class="footnote">内容以可读、可追溯、可长期维护为原则构建。</p>

  <style is:global>
    .landing { min-height: min(690px, calc(100vh - 5rem)); display: grid; grid-template-columns: minmax(0, 1.12fr) minmax(260px, .88fr); align-items: center; gap: clamp(2rem, 8vw, 8rem); padding: clamp(4.6rem, 10vw, 8rem) 0 clamp(3.5rem, 7vw, 5.5rem); }
    .eyebrow { margin: 0; color: var(--accent); font-size: .72rem; font-weight: 780; letter-spacing: .14em; }
    .eyebrow span { display: inline-block; width: 7px; height: 7px; margin-right: .5rem; border-radius: 50%; background: var(--accent); vertical-align: 1px; animation: pulse 2.6s ease-in-out infinite; }
    .intro h1 { max-width: 760px; margin: .88rem 0 1.4rem; color: var(--ink); font-size: clamp(3.35rem, 7.3vw, 6.75rem); line-height: .92; letter-spacing: -.082em; font-weight: 800; }
    .intro h1 em { font-family: ui-serif, Georgia, serif; font-weight: 420; letter-spacing: -.066em; }
    .lede { max-width: 630px; margin: 0; color: var(--muted); font-size: clamp(1.04rem, 1.6vw, 1.16rem); }
    .motion-field { position: relative; width: min(100%, 400px); aspect-ratio: 1; justify-self: end; display: grid; place-items: center; }
    .icon-core { position: relative; z-index: 3; width: 66%; overflow: hidden; border: 8px solid var(--surface); border-radius: 27%; box-shadow: 0 30px 60px rgba(17, 48, 38, .26); animation: float 6s ease-in-out infinite; }
    .icon-core img { width: 100%; display: block; }
    .halo { position: absolute; border: 1px solid var(--line); border-radius: 50%; opacity: .88; }
    .halo-one { inset: 4%; border-style: dashed; animation: spin 30s linear infinite; }
    .halo-two { inset: 15%; border-color: color-mix(in srgb, var(--accent) 52%, var(--line)); transform: scaleX(1.24) rotate(-20deg); animation: breathe 5s ease-in-out infinite; }
    .orbit { position: absolute; width: 86%; height: 49%; border: 1px solid color-mix(in srgb, var(--accent) 38%, transparent); border-radius: 50%; }
    .orbit i { position: absolute; width: 10px; height: 10px; background: var(--accent); border-radius: 50%; box-shadow: 0 0 0 6px color-mix(in srgb, var(--accent) 13%, transparent); }
    .orbit-a { transform: rotate(28deg); animation: spin 14s linear infinite; }
    .orbit-a i { right: 12%; top: -5px; }
    .orbit-b { width: 68%; height: 76%; transform: rotate(-34deg); animation: spin-reverse 19s linear infinite; }
    .orbit-b i { left: 11%; top: -5px; }
    .label { position: absolute; z-index: 4; padding: .34rem .64rem; border: 1px solid var(--line); border-radius: 999px; background: color-mix(in srgb, var(--surface) 92%, transparent); color: var(--muted); font-size: .78rem; box-shadow: 0 8px 18px rgba(21, 33, 26, .08); animation: float 6s ease-in-out infinite; }
    .label-one { right: 0; top: 12%; animation-delay: -1.2s; }
    .label-two { left: 0; bottom: 14%; animation-delay: -3s; }
    .route-nav { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
    .route-nav a { min-height: 154px; display: grid; grid-template-columns: auto 1fr auto; align-items: start; gap: .9rem; padding: 1.2rem 1.05rem; border-right: 1px solid var(--line); color: var(--ink); transition: background .22s ease, color .22s ease; }
    .route-nav a:first-child { padding-left: 0; }
    .route-nav a:last-child { border-right: 0; }
    .route-nav a:hover { background: var(--surface); color: var(--accent); }
    .route-index { color: var(--accent); font-weight: 800; letter-spacing: -.04em; }
    .route-nav strong { display: block; margin-top: -.1rem; font-size: 1.16rem; letter-spacing: -.03em; }
    .route-nav small { display: block; max-width: 15rem; margin-top: .35rem; color: var(--muted); line-height: 1.5; }
    .route-nav b { padding-top: 1rem; color: var(--accent); font-size: 1.3rem; }
    .footnote { margin: 1rem 0 0; color: var(--muted); font-size: .82rem; }
    @keyframes spin { to { transform: rotate(360deg); } }
    @keyframes spin-reverse { to { transform: rotate(-360deg); } }
    @keyframes float { 0%,100% { transform: translateY(0); } 50% { transform: translateY(-10px); } }
    @keyframes breathe { 0%,100% { opacity: .56; } 50% { opacity: 1; } }
    @keyframes pulse { 0%,100% { transform: scale(1); } 50% { transform: scale(.7); } }
    @media (prefers-reduced-motion: reduce) { *, *::before, *::after { animation-duration: .01ms !important; animation-iteration-count: 1 !important; scroll-behavior: auto !important; } }
    @media (max-width: 800px) { .landing { grid-template-columns: 1fr; min-height: 0; gap: 2rem; padding-top: 3.5rem; } .motion-field { justify-self: start; width: min(76vw, 340px); } .route-nav { grid-template-columns: 1fr; } .route-nav a, .route-nav a:first-child { min-height: 0; padding: 1rem 0; border-right: 0; border-bottom: 1px solid var(--line); } .route-nav a:last-child { border-bottom: 0; } .route-nav b { padding-top: 0; align-self: center; } }
    @media (max-width: 560px) { .landing { padding: 3rem 0 3.2rem; } .motion-field { width: min(85vw, 315px); } .intro h1 { font-size: clamp(3rem, 14vw, 4.5rem); } .route-nav strong { font-size: 1.08rem; } }
  </style>
</BaseLayout>
